.App {
  text-align: center;
}

.App-logo {
  height: 40vmin;
  pointer-events: none;
}

@media (prefers-reduced-motion: no-preference) {
  .App-logo {
    animation: App-logo-spin infinite 20s linear;
  }
}

.App-header {
  background-color: #282c34;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: calc(10px + 2vmin);
  color: white;
}

.App-link {
  color: #61dafb;
}

@keyframes App-logo-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* Shared login and registration screen */
.auth-page {
  min-height: 100vh;
  min-height: 100svh;
  box-sizing: border-box;
  display: grid;
  place-items: center;
  padding: 24px;
  color: #111827;
  background: linear-gradient(145deg, #51113d 0%, #bd285d 28%, #ff8b45 61%, #ffe66a 100%);
}

.auth-card {
  width: min(100%, 430px);
  box-sizing: border-box;
  padding: 30px 32px 28px;
  border: 1px solid rgba(255, 255, 255, 0.58);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18px 55px rgba(61, 15, 40, 0.2);
  backdrop-filter: blur(12px);
}

.auth-card h1 {
  margin: 0 0 18px;
  font-size: 2rem;
  font-weight: 600;
  letter-spacing: -0.035em;
}

.auth-card form {
  display: grid;
  gap: 8px;
}

.auth-card label {
  margin-top: 4px;
  font-size: 0.98rem;
  font-weight: 500;
}

.auth-card input {
  width: 100%;
  box-sizing: border-box;
  padding: 11px 12px;
  border: 1px solid rgba(31, 41, 55, 0.2);
  border-radius: 6px;
  outline: none;
  background: rgba(255, 255, 255, 0.88);
  color: #111827;
  font: inherit;
  transition: border-color 150ms ease, box-shadow 150ms ease;
}

.auth-card input:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.16);
}

.auth-submit {
  width: 100%;
  margin-top: 8px;
  padding: 12px 16px;
  border: 0;
  border-radius: 6px;
  background: #111827;
  color: #fff;
  font: inherit;
  font-weight: 600;
  cursor: pointer;
  transition: background 150ms ease, transform 150ms ease;
}

.auth-submit:hover:not(:disabled) {
  background: #273449;
}

.auth-submit:active:not(:disabled) {
  transform: translateY(1px);
}

.auth-submit:disabled {
  cursor: wait;
  opacity: 0.7;
}

.auth-link {
  display: inline-block;
  margin-top: 12px;
  color: #2563eb;
  font-weight: 500;
  text-decoration: none;
}

.auth-link:hover {
  text-decoration: underline;
}

.auth-error {
  margin: 14px 0 0;
  color: #9f1239;
  font-size: 0.92rem;
  overflow-wrap: anywhere;
}

@media (max-width: 480px) {
  .auth-page {
    padding: 18px;
  }

  .auth-card {
    padding: 26px 22px 24px;
  }
}

.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48px 24px;
  color: #111;
  text-align: center;
  background: #fff;
}

.home-page > h1 {
  margin: 0 0 28px;
  font-size: clamp(2rem, 4vw, 2.5rem);
}

.home-prompt {
  margin: 0 0 26px;
  font-size: 1.2rem;
}

.home-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 20px;
}

.home-actions button,
.message-form button,
.generate-link button {
  padding: 12px 28px;
  border: 1px solid #999;
  border-radius: 3px;
  background: #f5f5f5;
  color: #111;
  font: inherit;
  cursor: pointer;
}

.home-actions button:hover,
.message-form button:hover,
.generate-link button:hover {
  background: #e9e9e9;
}

.user-msg {
  width: min(100%, 650px);
  margin: 78px auto 0;
}

.generate-link h2 {
  margin: 0 0 28px;
  font-size: 2rem;
}

.generated-link {
  margin: 0 0 24px;
  overflow-wrap: anywhere;
  font-size: 1.35rem;
}

.message-form h2 {
  margin: 0 0 32px;
  font-size: 2rem;
}

.message-recipient,
.message-content {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 16px;
  padding: 14px;
  border: 1px solid #aaa;
  border-radius: 2px;
  background: #fff;
  color: #111;
  font: inherit;
}

.message-content {
  min-height: 150px;
  resize: vertical;
}

.message-form button {
  min-width: 115px;
}

.message-form [role='status'] {
  margin-top: 16px;
}

@media (max-width: 600px) {
  .home-page {
    padding: 36px 18px;
  }

  .user-msg {
    margin-top: 54px;
  }

  .message-form h2 {
    font-size: 1.6rem;
  }
}
